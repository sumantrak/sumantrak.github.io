---
layout: default
---
<div class="post cv-page">
  <header class="post-header cv-page__header">
    <div>
      <p class="cv-page__eyebrow">Curriculum vitae</p>
      <h1 class="post-title">{{ page.title }}</h1>
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}
    </div>
    {% if page.cv_pdf %}
      <a
        {% if page.cv_pdf contains '://' %}
          href="{{ page.cv_pdf }}"
        {% else %}
          href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
        {% endif %}
        target="_blank"
        rel="noopener noreferrer"
        class="cv-page__download"
      >
        <i class="fa-solid fa-file-pdf" aria-hidden="true"></i> PDF
      </a>
    {% endif %}
  </header>

  <article>
    <div class="cv">
      {% for entry in site.data.cv %}
        <a class="anchor" id="{{ entry.title }}"></a>
        <section class="cv-section">
          <div class="cv-section__heading">
            <span aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <h2>{{ entry.title }}</h2>
          </div>
          <div class="cv-section__content">
            {% if entry.type == 'list' %}
              {% include cv/list.liquid %}
            {% elsif entry.type == 'map' %}
              {% include cv/map.liquid %}
            {% elsif entry.type == 'nested_list' %}
              {% include cv/nested_list.liquid %}
            {% elsif entry.type == 'time_table' %}
              {% include cv/time_table.liquid %}
            {% elsif entry.type == 'list_groups' %}
              {% include cv/list_groups.liquid %}
            {% else %}
              {{ entry.contents }}
            {% endif %}
          </div>
        </section>
      {% endfor %}
    </div>
  </article>
</div>
